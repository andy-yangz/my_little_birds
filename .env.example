# Copy this file to .env (already gitignored) and fill in.

DEEPSEEK_API_KEY=

# Optional — only needed if you enable Reddit sources in config/sources.yaml.
# Create app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional — academic enrichment via OpenAlex + CrossRef.
# Both APIs are free and don't require keys, but they're nicer if you identify yourself.
# Set ENRICH_CONTACT_EMAIL to put you in the polite-users pool (higher rate limits, no auth).
ENRICH_CONTACT_EMAIL=

<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ date_str }} · my_little_birds</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --fg: #1a1814;
    --fg-soft: #5a5550;
    --muted: #8a847d;
    --bg: #f5f1ea;
    --card: #fffdf8;
    --card-hover: #fff8ed;
    --accent: #b8500a;
    --accent-soft: #f0dcc4;
    --border: #e0d8cb;
    --star: #d4a04a;
    --shadow: 0 1px 2px rgba(60,40,20,.04);
    --shadow-hover: 0 2px 4px rgba(60,40,20,.08), 0 8px 20px rgba(60,40,20,.04);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #ece8e0; --fg-soft: #b5ada3; --muted: #7a7268;
      --bg: #16140f; --card: #1f1c16; --card-hover: #2a261d;
      --accent: #f0a060; --accent-soft: #3a2818;
      --border: #2e2a22; --star: #e8b96a;
      --shadow: 0 1px 2px rgba(0,0,0,.3);
      --shadow-hover: 0 2px 4px rgba(0,0,0,.4), 0 8px 20px rgba(0,0,0,.25);
    }
  }
  * { box-sizing: border-box; }
  html, body { background: var(--bg); }
  body {
    font-family: 'Inter', -apple-system, "Segoe UI", "Hiragino Sans", "Microsoft YaHei", sans-serif;
    color: var(--fg); line-height: 1.55; margin: 0;
    padding: 2.5rem 1.5rem 5rem;
  }
  .container { max-width: 1200px; margin: 0 auto; }

  header.masthead {
    border-bottom: 2px solid var(--fg); padding-bottom: 1.25rem; margin-bottom: 2rem;
  }
  .masthead h1 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 700; font-size: 2.2rem;
    margin: 0 0 .2rem; letter-spacing: -0.02em; font-style: italic;
  }
  .masthead .meta {
    display: flex; gap: 1.25rem; align-items: baseline; flex-wrap: wrap;
    color: var(--muted); font-size: .85rem; font-variant-numeric: tabular-nums;
  }
  .masthead .meta strong { color: var(--fg); font-weight: 600; }
  .masthead .meta a { color: var(--accent); text-decoration: none; margin-left: auto; }

  /* Two-column grid */
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 760px) {
    .columns { grid-template-columns: 1fr; gap: 1rem; }
    body { padding: 2rem 1rem 4rem; }
  }
  .column h2 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    font-size: 1.3rem; letter-spacing: -0.01em;
    margin: 0 0 1rem; padding-bottom: .4rem;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: baseline; gap: .6rem;
  }
  .column h2 .count {
    font-family: 'Inter', sans-serif; font-size: .75rem; font-weight: 500;
    color: var(--muted); letter-spacing: 0;
  }

  /* Cluster card: collapsed by default, expand on click */
  details.cluster {
    background: var(--card); border: 1px solid var(--border); border-radius: 8px;
    margin-bottom: .65rem; box-shadow: var(--shadow);
    transition: box-shadow .15s ease, background .15s ease;
  }
  details.cluster:hover { background: var(--card-hover); box-shadow: var(--shadow-hover); }
  details.cluster[open] { box-shadow: var(--shadow-hover); }
  details.cluster > summary {
    list-style: none; cursor: pointer; padding: .85rem 1.05rem;
    display: flex; flex-direction: column; gap: .3rem;
  }
  details.cluster > summary::-webkit-details-marker { display: none; }
  details.cluster > summary::after {
    content: "▾"; color: var(--muted); position: absolute; right: 1.2rem;
    transition: transform .2s ease;
  }
  details.cluster[open] > summary::after { transform: rotate(180deg); }
  details.cluster > summary { position: relative; padding-right: 2.5rem; }

  .card-meta {
    display: flex; gap: .5rem; align-items: center; font-size: .72rem;
    color: var(--muted);
  }
  .stars { color: var(--star); letter-spacing: .5px; font-size: .8rem; }
  .stars .e { color: var(--border); }
  .signals { font-variant-numeric: tabular-nums; display: flex; gap: .55rem; flex-wrap: wrap; }
  .signals span { white-space: nowrap; }

  .card-title {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    font-size: 1.05rem; line-height: 1.3; letter-spacing: -0.005em;
    color: var(--fg);
  }
  .card-tags { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .15rem; }
  .tag {
    background: var(--accent-soft); color: var(--accent);
    padding: 1px 7px; border-radius: 8px; font-size: .68rem;
  }

  .cluster-body {
    padding: 0 1.05rem 1rem; color: var(--fg-soft); font-size: .9rem;
    border-top: 1px solid var(--border); padding-top: .9rem; margin-top: .2rem;
  }
  .cluster-body .summary { margin-bottom: .7rem; }
  .cluster-body .sources { font-size: .78rem; color: var(--muted); }
  .cluster-body .sources a { color: var(--fg-soft); text-decoration: none; border-bottom: 1px dotted var(--border); }
  .cluster-body .sources a:hover { color: var(--accent); border-color: var(--accent); }
  .cluster-body .sources .sep { margin: 0 .35rem; color: var(--border); }

  /* Per-paper cards inside econ cluster body */
  .papers { list-style: none; padding: 0; margin: .2rem 0 0; }
  .papers li {
    padding: .6rem 0;
    border-top: 1px dashed var(--border);
  }
  .papers li:first-child { border-top: none; padding-top: 0; }
  .papers .ptitle {
    color: var(--fg); font-weight: 500; text-decoration: none;
    font-size: .9rem; line-height: 1.35; display: block;
  }
  .papers .ptitle:hover { color: var(--accent); }
  .papers .psource {
    color: var(--muted); font-size: .7rem; margin-top: .15rem;
    font-variant-numeric: tabular-nums;
  }
  .papers .pline { font-size: .82rem; margin-top: .3rem; line-height: 1.45; color: var(--fg-soft); }
  .papers .lbl {
    display: inline-block; min-width: 2.4em; text-align: center;
    font-size: .65rem; font-weight: 600; letter-spacing: .03em;
    color: var(--accent); background: var(--accent-soft);
    padding: 1px .4rem; border-radius: 3px;
    margin-right: .4rem; vertical-align: 1px;
  }

  /* Sub-group header inside econ column */
  .subgroup {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    font-size: 1rem; color: var(--accent);
    margin: 1.4rem 0 .6rem; padding: 0 .1rem .25rem;
    border-bottom: 1px dotted var(--border);
    display: flex; align-items: baseline; gap: .45rem;
  }
  .subgroup:first-of-type { margin-top: 0; }
  .subgroup .count { color: var(--muted); font-size: .72rem; font-weight: 400; }

  details.raw {
    margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1.25rem;
  }
  details.raw > summary {
    cursor: pointer; color: var(--muted); font-size: .85rem;
    padding: .35rem 0; list-style: none;
  }
  details.raw > summary::-webkit-details-marker { display: none; }
  details.raw > summary::before { content: "▸ "; }
  details.raw[open] > summary::before { content: "▾ "; }
  .raw-cols {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1rem;
  }
  @media (max-width: 760px) { .raw-cols { grid-template-columns: 1fr; gap: 1rem; } }
  .raw-cols h3 {
    font-family: 'Fraunces', serif; font-weight: 600; font-size: .95rem;
    margin: 0 0 .5rem; color: var(--muted);
  }
  .raw-item {
    padding: .4rem 0; border-bottom: 1px dashed var(--border); font-size: .85rem;
  }
  .raw-item:last-child { border: none; }
  .raw-item a { color: var(--fg); text-decoration: none; }
  .raw-item a:hover { color: var(--accent); }
  .raw-item .m { color: var(--muted); font-size: .72rem; margin-top: .1rem; font-variant-numeric: tabular-nums; }

  footer {
    margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
    font-size: .76rem; color: var(--muted); text-align: center;
  }
</style>
</head>
<body>
<div class="container">

<header class="masthead">
  <h1>my_little_birds</h1>
  <div class="meta">
    <strong>{{ date_str }}</strong>
    {% for cat, items in by_category.items() %}
      <span>{{ cat_label(cat) }} · <strong>{{ items|length }}</strong></span>
    {% endfor %}
    <a href="index.html">归档 →</a>
  </div>
</header>

{% macro cluster_card(c, show_papers) %}
  {% set stars = c.stars|default(3) %}
  <details class="cluster">
    <summary>
      <div class="card-meta">
        <span class="stars">{% for _ in range(stars) %}★{% endfor %}{% for _ in range(5 - stars) %}<span class="e">★</span>{% endfor %}</span>
        <span class="signals">
          {% if c.sources %}<span>📰 {{ c.sources|length }}</span>{% endif %}
          {% if c.max_mention_count and c.max_mention_count > 1 %}<span>↗ {{ c.max_mention_count }}×</span>{% endif %}
          {% if c.max_hn_points %}<span>HN {{ c.max_hn_points }}↑</span>{% endif %}
          {% if c.max_citations %}<span>📚 {{ c.max_citations }}</span>{% endif %}
        </span>
      </div>
      <div class="card-title">{{ c.title }}</div>
      {% if c.tags %}
        <div class="card-tags">
          {% for t in c.tags %}<span class="tag">{{ t }}</span>{% endfor %}
        </div>
      {% endif %}
    </summary>
    <div class="cluster-body">
      {% if c.summary %}<div class="summary">{{ c.summary }}</div>{% endif %}
      {% if show_papers and c.sources and c.sources|selectattr("purpose")|list|length %}
        <ul class="papers">
          {% for s in c.sources %}
            <li>
              <a class="ptitle" href="{{ s.url }}" target="_blank" rel="noopener">{{ s.title or s.name }}</a>
              <div class="psource">{{ s.name }}</div>
              {% if s.purpose %}<div class="pline"><span class="lbl">目的</span>{{ s.purpose }}</div>{% endif %}
              {% if s.conclusion %}<div class="pline"><span class="lbl">结论</span>{{ s.conclusion }}</div>{% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="sources">
          {% for s in c.sources %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a>{% if not loop.last %}<span class="sep">·</span>{% endif %}{% endfor %}
        </div>
      {% endif %}
    </div>
  </details>
{% endmacro %}

<div class="columns">
{% for cat, clusters in summaries.items() %}
  <section class="column">
    <h2>{{ cat_label(cat) }} <span class="count">· {{ clusters|length }} 个聚类</span></h2>
    {% if cat == "econ" %}
      {% set macro_cs = clusters|selectattr("subtype", "equalto", "macro")|list %}
      {% set micro_cs = clusters|selectattr("subtype", "equalto", "micro")|list %}
      {% set other_cs = clusters|rejectattr("subtype", "in", ["macro", "micro"])|list %}
      {% if macro_cs %}
        <h3 class="subgroup">宏观 <span class="count">· {{ macro_cs|length }}</span></h3>
        {% for c in macro_cs %}{{ cluster_card(c, true) }}{% endfor %}
      {% endif %}
      {% if micro_cs %}
        <h3 class="subgroup">微观 <span class="count">· {{ micro_cs|length }}</span></h3>
        {% for c in micro_cs %}{{ cluster_card(c, true) }}{% endfor %}
      {% endif %}
      {% if other_cs %}
        <h3 class="subgroup">其他 <span class="count">· {{ other_cs|length }}</span></h3>
        {% for c in other_cs %}{{ cluster_card(c, true) }}{% endfor %}
      {% endif %}
    {% else %}
      {% for c in clusters %}{{ cluster_card(c, true) }}{% endfor %}
    {% endif %}
  </section>
{% endfor %}
</div>

<details class="raw">
  <summary>全部精选条目（{{ total }}）</summary>
  <div class="raw-cols">
    {% for cat, items in by_category.items() %}
      <div>
        <h3>{{ cat_label(cat) }} · {{ items|length }}</h3>
        {% for it in items %}
          <div class="raw-item">
            <a href="{{ it.url }}" target="_blank" rel="noopener">{{ it.title }}</a>
            <div class="m">
              {{ it.source_name }}
              {% if it.published %} · {{ it.published.strftime("%m-%d %H:%M") }}{% endif %}
              {% if it.extra.get("final_score") %} · {{ it.extra.final_score }}{% endif %}
              {% if it.extra.get("mention_count", 1) > 1 %} · {{ it.extra.mention_count }}×{% endif %}
              {% if it.extra.get("points") %} · HN {{ it.extra.points }}↑{% endif %}
              {% if it.extra.get("citation_count") %} · 📚 {{ it.extra.citation_count }}{% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</details>

<footer>my_little_birds · 每天 07:00 JST 生成 · 兴趣定义在 <code>config/interests.md</code></footer>

</div>
</body>
</html>
